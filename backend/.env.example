APP_NAME=Mock HRMS API
ENVIRONMENT=dev
APP_TIMEZONE=Asia/Kolkata
DATABASE_URL=sqlite+aiosqlite:///./storage/hrms.db
# Comma-separated allowed frontend origins, e.g. https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMPLOYEE_DOCUMENT_UPLOAD_DIR=/app/storage/employee-documents

# --- AI layer (Phase 4) ---
# AI_LLM_PROVIDER: "gemini" (default) or "anthropic"
AI_LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL_NAME=gemini-flash-latest
AI_MAX_OUTPUT_TOKENS=1024
AI_EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
AI_VECTOR_STORE_DIR=/app/storage/vector-store
AI_SQL_MAX_ROWS=200
INTERNAL_API_BASE_URL=http://127.0.0.1:8000
