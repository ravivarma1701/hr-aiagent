FROM python:3.11-slim

WORKDIR /app

# Safety net: chromadb/sentence-transformers pull in a couple of transitive
# deps that don't always ship a prebuilt wheel for every platform, in which
# case pip falls back to compiling from source.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
RUN chmod +x entrypoint.sh

ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1

EXPOSE 8000

ENTRYPOINT ["./entrypoint.sh"]
